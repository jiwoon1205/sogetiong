# 운영 서버용 백엔드 설정. 서버에서 이 파일을 복사해 deploy/backend.env 로 만든다 (Git에 올라가지 않음).
#   cp deploy/backend.env.example deploy/backend.env && nano deploy/backend.env

# 서버만 아는 비밀 도장. 서버에서 새로 만들어 넣는다:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 운영을 시작한 뒤에는 절대 바꾸지 말 것 (탈퇴·정지 이력을 알아볼 수 없게 되고 모두 로그아웃됨)
SECRET_KEY=

# 인증번호 메일 발송 (Gmail 예시: 구글 계정 → 보안 → 2단계 인증 → 앱 비밀번호)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

CORS_ORIGINS=https://private-matching.com
COOKIE_SECURE=true
REJOIN_COOLDOWN_DAYS=7

# 문의 메일 (학과 변경 요청, "내 학과가 목록에 없어요") — 화면에 표시됨. 비워두면 기본값 사용
SUPPORT_EMAIL=jiwoon@private-matching.com
