# 운영 서버용 백엔드 설정. 서버에서 이 파일을 복사해 deploy/backend.env 로 만든다 (Git에 올라가지 않음).
#   cp deploy/backend.env.example deploy/backend.env && nano deploy/backend.env

# 서버만 아는 비밀 도장. 서버에서 새로 만들어 넣는다:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 운영을 시작한 뒤에는 절대 바꾸지 말 것 (탈퇴·정지 이력을 알아볼 수 없게 되고 모두 로그아웃됨)
SECRET_KEY=

# 인증번호 메일 발송 (Gmail 예시: 구글 계정 → 보안 → 2단계 인증 → 앱 비밀번호)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

CORS_ORIGINS=https://private-matching.com
COOKIE_SECURE=true
# 탈퇴 후 재가입 대기 일수. 2026-10-05부터 0 (바로 가능, 점수·이용권은 이어받음)
REJOIN_COOLDOWN_DAYS=0

# 문의 메일 (학과 변경 요청, "내 학과가 목록에 없어요") — 화면에 표시됨. 비워두면 기본값 사용
SUPPORT_EMAIL=support@private-matching.com

# 휴대폰 알림 (2026-10-05). 서버에서 한 번 만들어 붙여 넣는다:
#   docker compose exec backend python -m app.scripts.make_vapid_keys
# 비워 두면 휴대폰 알림은 "준비 중"으로 보이고 메일 알림만 간다.
# ⚠️ 한 번 쓰기 시작하면 바꾸지 말 것 (바꾸면 모두 알림을 다시 켜야 함). 비밀 열쇠는 비밀번호 관리자에도 보관
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
