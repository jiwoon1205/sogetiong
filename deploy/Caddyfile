# Caddy: HTTPS 인증서 자동 발급·갱신 + 요청을 백엔드/화면으로 나눠 보내기
# 도메인의 DNS(A 레코드)가 이 서버 IP를 가리키고 있어야 인증서가 발급된다.

private-matching.com {
	encode zstd gzip

	# 사진 업로드: 한 번에 최대 3장 × 한 장 10MB 보다 넉넉하게 (보통은 화면에서 줄여서 1~2MB씩 보냄)
	request_body {
		max_size 35MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# 클릭재킹 방지: 다른 사이트가 우리 화면을 투명한 틀(iframe)에 몰래 넣어 클릭을 유도하지 못하게
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# /api/* 는 백엔드(FastAPI)로, 나머지는 화면(Next.js)으로
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	# 개인정보처리방침: 화면 빌드 없이 바로 고칠 수 있도록 정적 파일로 제공 (deploy/static/privacy.html)
	handle /privacy {
		root * /srv/static
		rewrite * /privacy.html
		file_server
	}
	# 이용약관 (2026-10-06): 개인정보처리방침과 같은 방식 (deploy/static/terms.html)
	handle /terms {
		root * /srv/static
		rewrite * /terms.html
		file_server
	}
	handle {
		reverse_proxy web:3000
	}
}

# www 로 들어오면 기본 주소로 보낸다
www.private-matching.com {
	redir https://private-matching.com{uri} permanent
}
