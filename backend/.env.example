APP_ENV=dev
# 로컬 개발용 SQLite. 운영에서는 PostgreSQL 주소를 넣는다.
# 예) postgresql+psycopg://user:password@localhost:5432/sogetiong
DATABASE_URL=sqlite:///./sogetiong_dev.db
# 서버만 아는 비밀 도장 (세션·인증번호·이메일 지문을 만들 때 사용). 32자 이상 무작위 문자열.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 운영에서는 아래 예시 값이면 서버가 켜지지 않는다.
# ⚠️ 운영을 시작한 뒤에는 바꾸지 말 것 (바꾸면 탈퇴·정지 이력을 알아볼 수 없고 모두 로그아웃됨).
SECRET_KEY=replace-with-a-long-random-secret

# console: 인증번호를 메일 대신 서버 콘솔에 출력 (개발용) / smtp: 실제 메일 발송
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-mail-account@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@example.com

# 개발용 사진 저장 폴더 (Git에 올라가지 않음)
LOCAL_STORAGE_DIR=./private_storage

# Next.js 개발 서버 주소
CORS_ORIGINS=http://localhost:3000

# 탈퇴 후 같은 학교 메일로 다시 가입하기까지 기다려야 하는 날 수 (0이면 바로 가능)
REJOIN_COOLDOWN_DAYS=7

# 매칭 점수 가중치 (합계 1.0 권장). 외적 평가는 WEIGHT_APPEARANCE_MAX를 넘을 수 없다.
WEIGHT_INTEREST=0.40
WEIGHT_APPEARANCE=0.20
WEIGHT_PREFERRED_DEPARTMENT=0.15
WEIGHT_COMPLETENESS=0.15
WEIGHT_MBTI=0.10
