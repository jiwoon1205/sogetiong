APP_ENV=dev
DATABASE_URL=sqlite:///./sogetiong.db
SECRET_KEY=replace-with-a-long-random-secret

# SMTP provider settings. Use an app password, never your normal account password.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-mail-account@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@example.com

# null allows the current file:// frontend during local development.
CORS_ORIGINS=null,http://localhost:3000,http://127.0.0.1:5500