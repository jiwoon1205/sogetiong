APP_ENV=dev
# 로컬 개발용 SQLite. 운영에서는 PostgreSQL 주소를 넣는다.
# 예) postgresql+psycopg://user:password@localhost:5432/sogetiong
DATABASE_URL=sqlite:///./sogetiong_dev.db
# 서버만 아는 비밀 도장 (세션·인증번호·이메일 지문을 만들 때 사용). 32자 이상 무작위 문자열.
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 운영에서는 아래 예시 값이면 서버가 켜지지 않는다.
# ⚠️ 운영을 시작한 뒤에는 바꾸지 말 것 (바꾸면 탈퇴·정지 이력을 알아볼 수 없고 모두 로그아웃됨).
SECRET_KEY=replace-with-a-long-random-secret

# console: 인증번호를 메일 대신 서버 콘솔에 출력 (개발용) / smtp: 실제 메일 발송
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-mail-account@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=no-reply@example.com

# 개발용 사진 저장 폴더 (Git에 올라가지 않음)
LOCAL_STORAGE_DIR=./private_storage

# Next.js 개발 서버 주소
CORS_ORIGINS=http://localhost:3000

# 탈퇴 후 같은 학교 메일로 다시 가입하기까지 기다려야 하는 날 수 (0이면 바로 가능)
REJOIN_COOLDOWN_DAYS=7

# 추천 순서: 외모 등급(상/중/하)이 같은 사람이 먼저. 같은 등급 안에서는 아래 세부 점수 가중치로 정렬 (합계 1.0 권장)
WEIGHT_INTEREST=0.60
WEIGHT_COMPLETENESS=0.25
WEIGHT_MBTI=0.15
# 활동 점수: 최근 14일 중 접속한 날이 많을수록 앞에 (매일 온 사람 +0.20)
WEIGHT_ACTIVITY=0.20
ACTIVITY_WINDOW_DAYS=14

# 나를 LIKE한 사람 우대: 한 페이지 최대 자리 수, 우대를 적용할 확률(0~1)
LIKED_ME_SLOTS=2
LIKED_ME_PROBABILITY=0.7

# PASS한 사람이 다시 추천에 나오기까지 걸리는 시간(시간 단위)
PASS_COOLDOWN_HOURS=48

# 하루(한국 시간 자정 기준) LIKE 한도
DAILY_LIKE_LIMIT=5

# 문의 메일 (학과 변경 요청, "내 학과가 목록에 없어요") — 화면에 표시됨
SUPPORT_EMAIL=jiwoon@private-matching.com

# 메일 속 링크에 쓰는 사이트 주소 (개발: 화면 주소)
SITE_URL=http://localhost:3000

# 이용권 (2026-10-04 구독제, 운영자 통장 직접 입금). 베타 동안은 false → 베타가 끝나는 날 true로 바꾸고 다시 시작
# 켜면 모든 회원(베타 회원 포함)이 이용권이 있어야 추천을 본다. 대화는 이용권 없이도 된다.
# (예전 이름 SIGNUP_FEE_ENABLED는 더 이상 읽지 않는다)
MEMBERSHIP_ENABLED=false
# 오픈 할인가 3,000원 (정가 4,000원, 2026-10-04). 할인이 끝나면 4000으로 바꾼다
MEMBERSHIP_PRICE=3000
MEMBERSHIP_DAYS=28
# 남은 기간이 이 일수 이하면 추천 화면 위에 "○일 남았어요" 띠
MEMBERSHIP_WARN_DAYS=3
# 입금받을 계좌 (서버 .env에만 적는다. GitHub에 올리지 않기)
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_HOLDER=
# 결제 가능 시간 (한국 시간): 오전 6시 ~ 밤 12시
PAYMENT_OPEN_HOUR=6
PAYMENT_CLOSE_HOUR=24

# 점검 기간 (2026-10-04): 정식 오픈 시각. 그 전에는 추천·LIKE·PASS·받은 LIKE·사진 재검토가 막히고 대화·결제만 된다.
# 점검 기간에 낸 이용권·VIP는 이 시각부터 4주. 시각이 지나면 자동으로 열린다. 점검이 없으면 이 줄을 빼거나 비워 둔다
# OPEN_AT=2026-10-10T18:00:00+09:00

# VIP 4주 이용권 (기본 포함, 할인 없음). 베타 동안은 false → 베타가 끝나는 날 MEMBERSHIP_ENABLED와 함께 true
VIP_ENABLED=false
# 판매 전에도 모두에게 "받은 LIKE" 탭을 보여줌 (혜택 안내 + 아래 문구, 결제 버튼 없음)
VIP_PREVIEW=true
VIP_PREVIEW_NOTICE=VIP는 무료 베타가 끝나는 날(10월 8일)부터 살 수 있어요.
VIP_DAYS=28
VIP_PRICE=6000
